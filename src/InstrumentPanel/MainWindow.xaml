<Window x:Class="InstrumentPanel.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Instrument Panel"
        Icon="icon/app.ico"
        Width="300" Height="300"
        MinWidth="120" MinHeight="120"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ResizeMode="CanResize"
        ShowInTaskbar="True"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Grid>
        <!-- Fenster-Hintergrund (Einstellungen > Hintergrund) - standardmäßig
             transparent, damit sich am bisherigen Verhalten nichts ändert.
             Liegt hinter allem anderen, blockiert keine Klicks. -->
        <Rectangle x:Name="WindowBackgroundLayer" Fill="Transparent" IsHitTestVisible="False" />

        <!-- Dynamisch befüllt anhand von layout.json (siehe MainWindow.xaml.cs) -->
        <Grid x:Name="GaugesGrid" />

        <!-- Dezenter Rahmen als optische Fensterkante (rein dekorativ, blockiert keine Klicks) -->
        <!-- Zwei-Ton-Rahmen (dunkel außen, hell innen) statt einfarbig - dadurch auf
             hellem UND dunklem Hintergrund gut sichtbar, nicht nur auf einem davon. -->
        <Border BorderBrush="#90000000" BorderThickness="2.5" IsHitTestVisible="False" />
        <Border BorderBrush="#CCFFFFFF" BorderThickness="1" Margin="1.5" IsHitTestVisible="False" />

        <!-- Verbindungsstatus: einmal zentral oben im Fenster statt in jeder Anzeige einzeln -->
        <TextBlock x:Name="GlobalStatusText"
                   Text="Verbinde..."
                   Foreground="Orange"
                   FontSize="13"
                   FontFamily="Consolas"
                   FontWeight="Bold"
                   HorizontalAlignment="Center" VerticalAlignment="Top"
                   Margin="0,6,0,0"
                   IsHitTestVisible="False" />

        <!-- Fenster-Steuerung (Minimieren/Maximieren/Schließen) mit dunklem
             Kontrastkasten dahinter, damit sie auch auf hellem Hintergrund
             (durch die Transparenz) sichtbar bleiben -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,4,0">
            <Grid Margin="0,0,4,0">
                <Rectangle Width="30" Height="30" Fill="#CC202020" RadiusX="4" RadiusY="4" />
                <Button x:Name="LayoutDesignerButton"
                        Content="&#x2699;"
                        Width="30" Height="30"
                        Background="Transparent"
                        BorderThickness="0"
                        Foreground="White"
                        FontSize="15"
                        Cursor="Hand"
                        ToolTip="Setup öffnen"
                        Click="LayoutDesignerButton_Click" />
            </Grid>
            <Grid Margin="0,0,4,0">
                <Rectangle Width="30" Height="30" Fill="#CC202020" RadiusX="4" RadiusY="4" />
                <Button x:Name="MinimizeButton"
                        Content="_"
                        Width="30" Height="30"
                        Background="Transparent"
                        BorderThickness="0"
                        Foreground="White"
                        FontSize="16"
                        FontWeight="Bold"
                        Cursor="Hand"
                        Click="MinimizeButton_Click" />
            </Grid>
            <Grid Margin="0,0,4,0">
                <Rectangle Width="30" Height="30" Fill="#CC202020" RadiusX="4" RadiusY="4" />
                <Button x:Name="MaximizeButton"
                        Content="&#x25A1;"
                        Width="30" Height="30"
                        Background="Transparent"
                        BorderThickness="0"
                        Foreground="White"
                        FontSize="14"
                        FontWeight="Bold"
                        Cursor="Hand"
                        Click="MaximizeButton_Click" />
            </Grid>
            <Grid>
                <Rectangle Width="30" Height="30" Fill="#CC202020" RadiusX="4" RadiusY="4" />
                <Button x:Name="CloseButton"
                        Content="✕"
                        Width="30" Height="30"
                        Background="Transparent"
                        BorderThickness="0"
                        Foreground="White"
                        FontSize="16"
                        FontWeight="Bold"
                        Cursor="Hand"
                        Click="CloseButton_Click" />
            </Grid>
        </StackPanel>

        <!-- Unsichtbare Greifbereiche an Kanten/Ecken zum Ändern der Fenstergröße
             (WindowStyle=None hat keinen eigenen Rahmen, daher selbst gebaut). -->
        <Rectangle Height="6" VerticalAlignment="Top" HorizontalAlignment="Stretch"
                   Fill="Transparent" Cursor="SizeNS" Tag="Top" MouseLeftButtonDown="ResizeHandle_MouseLeftButtonDown" />
        <Rectangle Height="6" VerticalAlignment="Bottom" HorizontalAlignment="Stretch"
                   Fill="Transparent" Cursor="SizeNS" Tag="Bottom" MouseLeftButtonDown="ResizeHandle_MouseLeftButtonDown" />
        <Rectangle Width="6" HorizontalAlignment="Left" VerticalAlignment="Stretch"
                   Fill="Transparent" Cursor="SizeWE" Tag="Left" MouseLeftButtonDown="ResizeHandle_MouseLeftButtonDown" />
        <Rectangle Width="6" HorizontalAlignment="Right" VerticalAlignment="Stretch"
                   Fill="Transparent" Cursor="SizeWE" Tag="Right" MouseLeftButtonDown="ResizeHandle_MouseLeftButtonDown" />
        <Rectangle Width="12" Height="12" HorizontalAlignment="Left" VerticalAlignment="Top"
                   Fill="Transparent" Cursor="SizeNWSE" Tag="TopLeft" MouseLeftButtonDown="ResizeHandle_MouseLeftButtonDown" />
        <Rectangle Width="12" Height="12" HorizontalAlignment="Right" VerticalAlignment="Top"
                   Fill="Transparent" Cursor="SizeNESW" Tag="TopRight" MouseLeftButtonDown="ResizeHandle_MouseLeftButtonDown" />
        <Rectangle Width="12" Height="12" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                   Fill="Transparent" Cursor="SizeNESW" Tag="BottomLeft" MouseLeftButtonDown="ResizeHandle_MouseLeftButtonDown" />
        <Rectangle Width="12" Height="12" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                   Fill="Transparent" Cursor="SizeNWSE" Tag="BottomRight" MouseLeftButtonDown="ResizeHandle_MouseLeftButtonDown" />
    </Grid>
</Window>
